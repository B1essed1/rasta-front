# Normalise to LF in the repository. Without this, a Windows checkout commits
# CRLF and the deploy scripts die on the server with:
#   /usr/bin/env: 'bash\r': No such file or directory
* text=auto eol=lf

# Never touched by newline conversion.
*.jar    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.pdf    binary
